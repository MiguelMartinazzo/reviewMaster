{
    "name": "reviewmaster",
    "version": "1.0.0",
    "description": "Games forum",
    "main": "db.config.js",
    "scripts": {
        "ng": "ng",
        "start": "npm-run-all --parallel \"start:api\" \"start:db\" \"start:client\"",
        "start:api": "cd node-mongoose-jwt && node ./bin/www",
        "start:db": "node server.js",
        "start:client": "ng serve -o",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "serve:ssr:GamesReview": "node dist/games-review/server/server.mjs"
    },
